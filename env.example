# Copy to .env (which is git-ignored) and set a real password:  cp .env.example .env
DB_NAME=videos
DB_USER=video_user
DB_PASSWORD=change-me

# Zoom post-processing (all optional)
# Public host:port used to build the processed video URL stored in PostgreSQL.
# Set it to the address users actually open, e.g. https://videos.example.com
PUBLIC_BASE_URL=http://localhost:8000
# FFMPEG_BIN=ffmpeg
# WORKER_POLL_SEC=1
# ZOOM_TIMEOUT_SEC=1800
# ZOOM_MAX_ATTEMPTS=3
# WORKER_STALE_SEC=1800
# MAX_SIDECAR_KB=2048
# WEB_PORT=8000

# Company import + Impressum enrichment (Internship Task 3)
# Provided by the instructor; keep it out of git (.env is ignored).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# HTTP_TIMEOUT=20
# HTTP_DELAY_SEC=0.5
# MAX_COMPANIES_CSV_KB=5120
