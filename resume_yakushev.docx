        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/x-icon" href="favicon.ico">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">

        <script src="https://www.cdn-tinkoff.ru/twa/v5/bundles/generic/client.js?container=fintech&amp;project=edu&amp;ttm=tinkoff-pwa_edu" onload="window.trackingLogger?.log('tracking loaded');" defer></script>

        <script type="text/javascript">
            (function () {
                var host = window.location.host;
                var path = '/eventea/bundle/eventea.bundle.js?project=edu&appName=edu';

                host = host && host.includes('.tbank-online.com') ? 'cdn.tbank-online.com' : 'cdn.tbank.ru';

                var script = document.createElement('script');
                script.src = 'https://' + host + path;
                script.onload = function () {
                    window.trackingLogger?.log('eventea loaded');
                };
                script.defer = true;
                document.head.appendChild(script);
            })();
        </script>
